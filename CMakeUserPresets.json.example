{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug → ../MeasureExpert_runtime/MeasureExpertD.exe",
      "binaryDir": "${sourceDir}/../MeasureExpert_runtime/.cmake/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ME_RUNTIME_DIR": "${sourceDir}/../MeasureExpert_runtime",
        "CMAKE_PREFIX_PATH": "<YOUR_QT_MSVC_PREFIX>"
      }
    },
    {
      "name": "release",
      "displayName": "Release → ../MeasureExpert_runtime/MeasureExpert.exe",
      "binaryDir": "${sourceDir}/../MeasureExpert_runtime/.cmake/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ME_RUNTIME_DIR": "${sourceDir}/../MeasureExpert_runtime",
        "CMAKE_PREFIX_PATH": "<YOUR_QT_MSVC_PREFIX>"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ]
}
